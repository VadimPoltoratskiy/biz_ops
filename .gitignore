# Python bytecode and caches
__pycache__/
*.py[cod]
.mypy_cache/
.pytest_cache/

# Virtual environments
.venv/
venv/
.uv/

# Environment files (never commit secrets; .env.example IS tracked)
.env

# Per-run artifact directories (user-local runtime data, not source)
runs/

# Distribution artifacts
dist/
*.egg-info/
.eggs/

# Editor noise
.DS_Store
*.swp

# rules/ is NOT ignored — the committed rules cache must remain tracked
# data/ is NOT ignored — the regulation source is committed

# CI eval artifacts (regenerated per run)
eval-result.json
devdigest-result.json
